                  <Insets left="20.0" />
               </HBox.margin>
            </Button>
         </children>
      </HBox>
        <TableView fx:id="table" cache="true" minWidth="-Infinity" prefHeight="236.0" prefWidth="1000.0">
            <columns>
                <TableColumn fx:id="numberColumn" minWidth="1.0" prefWidth="75.0" reorderable="false" text="Číslo" />
                <TableColumn fx:id="typeColumn" minWidth="1.0" prefWidth="84.0" reorderable="false" text="Typ" />
                <TableColumn fx:id="dateTimeColumn" minWidth="1.0" prefWidth="118.0" reorderable="false" text="Dátum a čas" />
                <TableColumn fx:id="partnerNameColumn" minWidth="1.0" prefWidth="99.0" reorderable="false" text="Partner" />
                <TableColumn fx:id="vehicleINColumn" minWidth="1.0" prefWidth="96.0" reorderable="false" text="Vozidlo" />
                <TableColumn fx:id="issuedNameColumn" minWidth="1.0" prefWidth="109.0" reorderable="false" text="Vystavil" />
                <TableColumn fx:id="materialColumn" minWidth="1.0" prefWidth="114.0" reorderable="false" text="Materiál" />
                <TableColumn fx:id="grossColumn" minWidth="1.0" prefWidth="64.0" reorderable="false" text="Brutto" />
                <TableColumn fx:id="taraColumn" minWidth="1.0" prefWidth="88.0" reorderable="false" text="Tara" />
                <TableColumn fx:id="nettColumn" minWidth="1.0" prefWidth="100.0" reorderable="false" text="Netto" />
                <TableColumn fx:id="descriptionColumn" minWidth="100.0" prefWidth="-1.0" reorderable="false" text="Poznámka" />
            </columns>
        </TableView>
    </children>
</VBox>
