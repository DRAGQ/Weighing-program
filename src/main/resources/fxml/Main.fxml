                        <MenuItem fx:id="weightAcceptance" mnemonicParsing="false" onAction="#showWeightAcceptance" text="Príjemka" />
                        <MenuItem fx:id="weightExtradition" mnemonicParsing="false" onAction="#showWeightExtradition" text="Výdajka" />
                        <SeparatorMenuItem mnemonicParsing="false" />
                        <MenuItem fx:id="weightUpdateWeighing" mnemonicParsing="false" onAction="#showUpdateWeighing" text="Upraviť váženie" />
                        <MenuItem fx:id="weightDeleteWeighing" mnemonicParsing="false" onAction="#weightDelete" text="Vymazať váženie" />
