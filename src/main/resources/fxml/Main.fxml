                        <MenuItem fx:id="weightPrintWeighingTicket" mnemonicParsing="false" onAction="#showWeightPrintWeighingTicket" text="Tlačiť vážny lístok" />
                        <MenuItem fx:id="weightPrintOverview" mnemonicParsing="false" onAction="#showWeightPrintOverview" text="Tlačiť prehľad" />
                    </items>
                </Menu>
                <Menu mnemonicParsing="false" text="Nastavenia">
