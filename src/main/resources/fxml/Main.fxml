                <VBox fx:id="taraWrapper" alignment="TOP_CENTER" prefHeight="200.0" prefWidth="120.0">
                    <children>
                        <ImageView fx:id="taraImageView" fitHeight="40.0" fitWidth="60.0" pickOnBounds="true" preserveRatio="true" />
