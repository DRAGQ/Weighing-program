                    </children>
                    <HBox.margin>
                        <Insets left="20.0" />
                    </HBox.margin>
                </VBox>
                <VBox fx:id="acceptanceWrapper" alignment="TOP_CENTER" prefHeight="200.0" prefWidth="100.0">
                    <children>
                        <ImageView fx:id="acceptanceImageView" fitHeight="40.0" fitWidth="60.0" pickOnBounds="true" preserveRatio="true" />
                        <Label text="Príjemka" />
                    </children>
                </VBox>
                <VBox fx:id="extradictionWrapper" alignment="TOP_CENTER" prefHeight="200.0" prefWidth="100.0">
