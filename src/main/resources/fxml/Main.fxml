                        <ImageView fx:id="printOverviewImageView" fitHeight="40.0" fitWidth="60.0" pickOnBounds="true" preserveRatio="true" />
                        <Label text="Tlačiť prehľad" />
                    </children>
                </VBox>
            </children>
         <VBox.margin>
            <Insets bottom="10.0" />
         </VBox.margin>
        </HBox>
        <HBox fx:id="currentTimeHBox" prefHeight="52.0" prefWidth="863.0">
            <children>
                <Label prefHeight="52.0" prefWidth="115.0" text="Dátum a čas:">
               <HBox.margin>
                  <Insets left="10.0" />
               </HBox.margin></Label>
                <Label fx:id="currentTimeLabel" prefHeight="52.0" prefWidth="171.0" text="Time">
                    <HBox.margin>
                        <Insets right="15.0" />
                    </HBox.margin>
                    <font>
                        <Font name="Cambria Bold" size="20.0" />
                    </font>
                </Label>
                <Label prefHeight="52.0" prefWidth="171.0" text="Hmotnosť:" />
            </children>
        </HBox>
        <ListView fx:id="listView" orientation="HORIZONTAL" prefHeight="26.0" prefWidth="863.0">
            <cursor>
                <Cursor fx:constant="DEFAULT" />
            </cursor>
         <VBox.margin>
            <Insets />
         </VBox.margin>
         <padding>
            <Insets left="2.0" />
         </padding>
        </ListView>
      <HBox fx:id="customPeriodHBox" alignment="CENTER_LEFT" prefHeight="36.0" prefWidth="1396.0">
         <children>
            <Label prefHeight="36.0" prefWidth="129.0" text="Dátum váženia od:">
               <HBox.margin>
                  <Insets left="10.0" />
               </HBox.margin>
            </Label>
            <DatePicker fx:id="customPeriodStart" prefHeight="25.0" prefWidth="133.0" />
            <Label prefHeight="36.0" prefWidth="27.0" text="do:">
               <HBox.margin>
                  <Insets left="20.0" />
               </HBox.margin>
            </Label>
            <DatePicker fx:id="customPeriodEnd" prefHeight="25.0" prefWidth="133.0" />
            <Button mnemonicParsing="false" onAction="#customPeriod" prefHeight="25.0" prefWidth="149.0" text="🔄 Načitať váženia">
