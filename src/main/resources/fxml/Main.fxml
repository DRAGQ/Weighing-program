<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox minHeight="-Infinity" minWidth="-Infinity" prefHeight="480.0" prefWidth="1400.0" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.ivoprojekt.controller.MainController">
    <children>
        <MenuBar prefHeight="0.0" prefWidth="799.0">
            <menus>
                <Menu mnemonicParsing="false" text="Použivateľ">
                    <items>
                        <MenuItem fx:id="userLogin" mnemonicParsing="false" onAction="#loginUser" text="Prihlásenie" />
                        <MenuItem fx:id="userRegister" mnemonicParsing="false" onAction="#registerUser" text="Registrácia" />
                        <MenuItem fx:id="userChangePassword" mnemonicParsing="false" onAction="#changePassword" text="Zmeniť heslo" />
                        <MenuItem fx:id="userLogout" mnemonicParsing="false" onAction="#logout" text="Odhlásiť" />
                    </items>
                </Menu>
                <Menu mnemonicParsing="false" text="Číselníky">
                    <items>
                        <MenuItem fx:id="dialsUsers" mnemonicParsing="false" onAction="#showAllUsers" text="Použivatelia" />
                        <MenuItem fx:id="dialsPartners" mnemonicParsing="false" onAction="#showAllPartners" text="Partneri" />
                        <MenuItem fx:id="dialsVehicles" mnemonicParsing="false" onAction="#showAllVehicles" text="Vozidlá" />
                        <MenuItem fx:id="dialsTypeOfMaterial" mnemonicParsing="false" onAction="#showAllMaterials" text="Druhy Materiálu" />
                    </items>
                </Menu>
                <Menu mnemonicParsing="false" text="Váženie">
                    <items>
                        <MenuItem fx:id="weightTaraSetting" mnemonicParsing="false" onAction="#showWeighingTaraSetting" text="Nastaviť taru" />
